# ── Stage 1: build ────────────────────────────────────────────────────────
# Compiles Python packages that have no musllinux wheels (e.g. cryptography,
# aiohttp) against Alpine musl so the runtime stage stays build-tool-free.
FROM alpine:edge AS builder

RUN apk add --no-cache \
        python3 \
        py3-pip \
        py3-olm \
        py3-numpy \
        gcc \
        g++ \
        musl-dev \
        python3-dev \
        openssl-dev \
        libffi-dev \
        crc32c-dev

# Create a venv that can see system py3-olm so pip accepts matrix-nio[e2e]
RUN python3 -m venv --system-site-packages /venv

COPY requirements.txt requirements-voip.txt ./
RUN /venv/bin/pip install --no-cache-dir \
        -r requirements.txt \
        -r requirements-voip.txt \
        pathvalidate


# ── Stage 2: runtime ──────────────────────────────────────────────────────
FROM alpine:edge

# Runtime system deps:
#   python3         — interpreter
#   py3-olm         — E2EE (visible to venv via --system-site-packages)
#   nodejs/npm      — AgentSkills
#   espeak-ng       — phonemisation for Piper
#   ffmpeg          — audio codec support for aiortc/av
#   libstdc++       — C++ runtime
#   py3-onnxruntime — ONNX runtime for piper-tts (musl-native, visible to venv)
RUN apk add --no-cache \
        python3 \
        py3-olm \
        py3-pathvalidate \
        nodejs \
        npm \
        espeak-ng \
        ffmpeg \
        wget \
        py3-numpy \
        py3-onnxruntime \
        openssl \
        openssh-client \
        git \
        libffi \
        libstdc++ \
        crc32c \
    && apk add --no-cache --repository=https://dl-cdn.alpinelinux.org/alpine/edge/testing \
        piper-tts

WORKDIR /app

# Copy the venv from the builder
COPY --from=builder /venv /venv
ENV PATH="/venv/bin:$PATH"
ENV PYTHONPATH="/usr/lib/python3.14/site-packages"

# Application code
COPY pawlia/ pawlia/
COPY skills/ skills/
RUN mkdir -p skills/user

# Install deps + compile workflows for all pre-bundled skills
RUN python3 -m pawlia.install_skill_deps --no-compile

# German Piper voices (low quality, 16 kHz, ~63 MB each → ~252 MB total)
RUN mkdir -p /app/piper && \
    for voice in karlsson kerstin ramona thorsten; do \
        wget -O "/app/piper/de_DE-${voice}-low.onnx" \
            "https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/de/de_DE/${voice}/low/de_DE-${voice}-low.onnx" && \
        wget -O "/app/piper/de_DE-${voice}-low.onnx.json" \
            "https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/de/de_DE/${voice}/low/de_DE-${voice}-low.onnx.json" && \
        test -s "/app/piper/de_DE-${voice}-low.onnx" \
            || { echo "ERROR: voice download failed for ${voice}"; exit 1; } ; \
    done


# Session data lives in a volume
VOLUME ["/app/session"]

ENV PYTHONUNBUFFERED=1

CMD ["python3", "-m", "pawlia", "--mode", "server"]
