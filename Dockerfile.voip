# ── Stage 1: build ────────────────────────────────────────────────────────
FROM alpine:edge AS builder

# Wir installieren alles direkt ins System
RUN apk add --no-cache \
        python3 \
        py3-pip \
        py3-olm \
        py3-numpy \
        gcc \
        g++ \
        musl-dev \
        python3-dev \
        openssl-dev \
        libffi-dev \
        crc32c-dev \
        libxml2-dev \
        libxslt-dev

COPY constraints.txt requirements.txt requirements-e2e.txt requirements-voip.txt ./

# Installation direkt in die System-Packages
# --break-system-packages ist in neuen Python-Versionen Pflicht
RUN pip install --break-system-packages --no-cache-dir \
        -c constraints.txt \
        -r requirements.txt \
        -r requirements-e2e.txt \
        -r requirements-voip.txt

# ── Stage 2: runtime ──────────────────────────────────────────────────────
FROM alpine:edge

# System-Abhängigkeiten
RUN apk add --no-cache \
        python3 \
        py3-pip \
        py3-olm \
        nodejs \
        npm \
        espeak-ng \
        ffmpeg \
        wget \
        py3-numpy \
        py3-onnxruntime \
        openssl \
        openssh-client \
        git \
        libffi \
        libstdc++ \
        crc32c \
        libxml2 \
        libxslt \
    && apk add --no-cache --repository=https://dl-cdn.alpinelinux.org/alpine/edge/testing \
        piper-tts

WORKDIR /app
COPY constraints.txt constraints.txt
ENV PIP_CONSTRAINT=/app/constraints.txt

# Wir kopieren nur die installierten Python-Packages aus dem Builder
# Anstatt des ganzen venv kopieren wir den site-packages Ordner
COPY --from=builder /usr/lib/python3.14/site-packages /usr/lib/python3.14/site-packages

# Application code
COPY pawlia/ pawlia/
COPY skills/ skills/
RUN mkdir -p skills/user

# Da wir kein venv haben, nutzen wir einfach das System-Python
RUN python3 -m pawlia.install_skill_deps --no-compile

# Stimmen-Download
RUN mkdir -p /app/piper && \
    for voice in karlsson kerstin ramona thorsten; do \
        wget -O "/app/piper/de_DE-${voice}-low.onnx" \
            "https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/de/de_DE/${voice}/low/de_DE-${voice}-low.onnx" && \
        wget -O "/app/piper/de_DE-${voice}-low.onnx.json" \
            "https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/de/de_DE/${voice}/low/de_DE-${voice}-low.onnx.json" && \
        test -s "/app/piper/de_DE-${voice}-low.onnx" \
            || { echo "ERROR: voice download failed for ${voice}"; exit 1; } ; \
    done

VOLUME ["/app/session"]
ENV PYTHONUNBUFFERED=1

# Kein PATH-Hacking mehr nötig
CMD ["python3", "-m", "pawlia", "--mode", "server"]
