# ── Stage 1: build ────────────────────────────────────────────────────────
FROM python:3.14-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        python3-dev \
        libffi-dev \
        libssl-dev \
        libxml2-dev \
        libxslt1-dev \
        libolm-dev \
        gcc \
        g++ \
    && rm -rf /var/lib/apt/lists/*

COPY constraints.txt requirements.txt requirements-e2e.txt requirements-voip.txt ./

# Ensure _libolm.abi3.so links against libstdc++ explicitly.
# CFFI uses gcc (not g++), so without this flag libolm.so.3 C++ symbols are
# undefined on platforms where libolm.so.3 doesn't declare libstdc++ as NEEDED
# (reproducible on aarch64 Debian bookworm).
ENV LDFLAGS="-Wl,--no-as-needed -lstdc++ -Wl,--as-needed"

RUN pip install --no-cache-dir \
        -c constraints.txt \
        -r requirements.txt \
        -r requirements-e2e.txt \
        -r requirements-voip.txt

# ── Stage 2: runtime ──────────────────────────────────────────────────────
FROM python:3.14-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        espeak-ng \
        espeak-ng-data \
        ffmpeg \
        flac \
        wget \
        ca-certificates \
        openssl \
        openssh-client \
        git \
        bubblewrap \
        libffi8 \
        libstdc++6 \
        libolm3 \
    && rm -rf /var/lib/apt/lists/*

# Node.js 20 via NodeSource.
# Pinned to 20 (not setup_lts.x = node 24): the Deutsche Bahn API is fronted by
# Akamai, which 403-blocks Node 24's TLS/HTTP fingerprint. Node 20 is verified
# working (same container, same IP, same db-vendo-client) — see hermes-agent.
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Optional coding backends for the skill-creator (config: coding.backend).
# Baked in so prod always has them; the config skill can also install at
# runtime when missing. opencode is the preferred agentic backend; aider is
# the CLI fallback.
RUN npm install -g opencode-ai \
    && pip install --no-cache-dir aider-chat

WORKDIR /app
COPY constraints.txt constraints.txt
ENV PIP_CONSTRAINT=/app/constraints.txt

# Python-Packages aus Builder kopieren
COPY --from=builder /usr/local/lib/python3.14/site-packages /usr/local/lib/python3.14/site-packages
# piper-Console-Script liegt in /usr/local/bin, nicht in site-packages
COPY --from=builder /usr/local/bin/piper /usr/local/bin/piper

# Runtime safety net: preload libstdc++ before any C extension is imported so
# that libolm.so.3 C++ symbols resolve even if _libolm.abi3.so's NEEDED list
# doesn't explicitly include libstdc++.so.6 (arch-dependent linker behaviour).
RUN printf 'import ctypes\ntry:\n    ctypes.CDLL("libstdc++.so.6", ctypes.RTLD_GLOBAL)\nexcept Exception:\n    pass\n' \
    >> /usr/local/lib/python3.14/sitecustomize.py

# Application code
COPY pawlia/ pawlia/
COPY skills/ skills/
RUN mkdir -p skills/user

RUN node --version && npm --version

RUN python3 -m pawlia.install_skill_deps --no-compile

# Stimmen-Download
RUN mkdir -p /app/piper && \
    for voice in karlsson kerstin ramona thorsten; do \
        wget -O "/app/piper/de_DE-${voice}-low.onnx" \
            "https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/de/de_DE/${voice}/low/de_DE-${voice}-low.onnx" && \
        wget -O "/app/piper/de_DE-${voice}-low.onnx.json" \
            "https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/de/de_DE/${voice}/low/de_DE-${voice}-low.onnx.json" && \
        test -s "/app/piper/de_DE-${voice}-low.onnx" \
            || { echo "ERROR: voice download failed for ${voice}"; exit 1; } ; \
    done

VOLUME ["/app/session"]
ENV PYTHONUNBUFFERED=1

CMD ["python3", "-m", "pawlia", "--mode", "server"]
