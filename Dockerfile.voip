# ── Stage 1: build ────────────────────────────────────────────────────────
# Compiles Python packages that have no musllinux wheels (e.g. cryptography,
# aiohttp) against Alpine musl so the runtime stage stays build-tool-free.
FROM alpine:3.21 AS builder

RUN apk add --no-cache \
        python3 \
        py3-pip \
        py3-olm \
        gcc \
        g++ \
        musl-dev \
        python3-dev \
        openssl-dev \
        libffi-dev \
        crc32c-dev

# Create a venv that can see system py3-olm so pip accepts matrix-nio[e2e]
RUN python3 -m venv --system-site-packages /venv

COPY requirements.txt requirements-voip.txt ./
RUN /venv/bin/pip install --no-cache-dir \
        -r requirements.txt \
        -r requirements-voip.txt


# ── Stage 2: runtime ──────────────────────────────────────────────────────
FROM alpine:3.21

# Runtime system deps:
#   python3      — interpreter
#   py3-olm      — E2EE (visible to venv via --system-site-packages)
#   nodejs/npm   — AgentSkills
#   espeak-ng    — phonemisation for Piper
#   ffmpeg       — audio codec support for aiortc/av
#   libstdc++    — C++ runtime for Piper
#   piper-tts    — local TTS engine (Alpine edge/testing, musl-native)
RUN apk add --no-cache \
        python3 \
        py3-olm \
        nodejs \
        npm \
        espeak-ng \
        ffmpeg \
        wget \
        openssl \
        libffi \
        libstdc++ \
        crc32c \
    && apk add --no-cache --repository=https://dl-cdn.alpinelinux.org/alpine/edge/testing \
        piper-tts

WORKDIR /app

# Copy the venv from the builder
COPY --from=builder /venv /venv
ENV PATH="/venv/bin:$PATH"

# Application code
COPY pawlia/ pawlia/
COPY skills/ skills/
RUN mkdir -p skills/user

# Install deps + compile workflows for all pre-bundled skills
RUN python3 -m pawlia.install_skill_deps --no-compile

# Default voice model: German Kerstin low (~63 MB, 16 kHz)
RUN mkdir -p /app/piper && \
    wget -O /app/piper/de_DE-kerstin-low.onnx \
        "https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/de/de_DE/kerstin/low/de_DE-kerstin-low.onnx" && \
    wget -O /app/piper/de_DE-kerstin-low.onnx.json \
        "https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/de/de_DE/kerstin/low/de_DE-kerstin-low.onnx.json" && \
    test -s /app/piper/de_DE-kerstin-low.onnx || { echo "ERROR: voice model download failed"; exit 1; }


# Session data lives in a volume
VOLUME ["/app/session"]

ENV PYTHONUNBUFFERED=1

CMD ["python3", "-m", "pawlia", "--mode", "server"]
